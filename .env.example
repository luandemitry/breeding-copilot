# Copy to .env and fill in. Never commit .env.

# --- LLM (free tier only) ---------------------------------------------------
# Default: Gemini Flash via Google AI Studio (free tier). Key: https://aistudio.google.com/apikey
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Switch providers without code changes (LangChain init_chat_model):
#   Groq:   LLM_PROVIDER=groq    LLM_MODEL=llama-3.3-70b-versatile   GROQ_API_KEY=...   (uv sync --extra groq)
#   Ollama: LLM_PROVIDER=ollama  LLM_MODEL=llama3.1                  OLLAMA_BASE_URL=http://localhost:11434  (uv sync --extra ollama)

# --- Free-tier rate limiting ------------------------------------------------
LLM_REQUESTS_PER_MINUTE=10
LLM_MAX_RETRIES=5
